{
  "name": "spotlight-demo-video",
  "version": "1.0.0",
  "description": "Spotlight 2-minute demo video (Remotion)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "@remotion/google-fonts": "4.0.543",
    "@remotion/media": "4.0.543",
    "@remotion/studio": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.543",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render": "remotion render SpotlightDemo out/spotlight-demo.mp4 --codec=h264 --crf=16 --audio-codec=aac",
    "render:720": "ffmpeg -y -v error -i out/spotlight-demo.mp4 -vf scale=1280:720:flags=lanczos -c:v libx264 -crf 21 -preset medium -pix_fmt yuv420p -c:a aac -b:a 160k -movflags +faststart out/spotlight-demo-720p.mp4"
  },
  "allowScripts": {
    "esbuild": false
  }
}